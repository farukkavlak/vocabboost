{
  "name": "vocabboost",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Look up a word from a film's subtitles without leaving the film",
  "license": "MIT",
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspace extension",
    "typecheck": "npm run typecheck --workspace extension",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "playwright test",
    "test:live": "LIVE=1 playwright test youtube-live",
    "shots": "SHOTS=1 playwright test screenshots",
    "test:memory": "MEMORY=1 playwright test memory",
    "test:comparison": "COMPARISON=1 playwright test comparison",
    "recording": "bash scripts/recording.sh",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
